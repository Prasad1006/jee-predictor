# Copy to .env and adjust
SECRET_KEY=change-me-in-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (optional — defaults to SQLite for local dev)
# DATABASE_URL=postgresql://josaa:josaa@localhost:5432/josaa_copilot

# Or individual vars:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=josaa_copilot
# DB_USER=josaa
# DB_PASSWORD=josaa
# DB_HOST=localhost
# DB_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:3000

# JoSAA cutoff years used for predictions (newest first)
DEFAULT_CUTOFF_YEAR=2025
CUTOFF_PREFERRED_YEARS=2025,2024

